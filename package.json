{
  "name": "gazbook",
  "version": "1.6.2",
  "description": "Format books for Amazon KDP in under a minute: translated paperback PDF, Kindle EPUB, Word, covers and marketing kit.",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-all.js",
    "dist": "node scripts/bundle-python.js && electron-builder --win nsis --publish never",
    "speed": "node test/speed.js"
  },
  "author": "Gaz Media",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "fontkit": "^2.0.4",
    "htmlparser2": "^9.1.0",
    "hyphen": "^1.14.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "node-llama-cpp": "^3.22.2",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "productName": "GazBook",
  "build": {
    "appId": "ng.com.gazgoc.gazbook",
    "productName": "GazBook",
    "copyright": "Copyright © Gaz Media",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**",
      "src/**",
      "fonts/**",
      "package.json",
      "!node_modules/@node-llama-cpp/*cuda*/**",
      "!node_modules/@node-llama-cpp/{linux,mac}-*/**",
      "!node_modules/node-llama-cpp/llama/llama.cpp/**"
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**",
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "GazBook-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GazBook",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "build/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "translator",
        "to": "translator",
        "filter": [
          "worker.py"
        ]
      }
    ]
  }
}
